NODE_ENV=development
VUE_APP_MODE=development
VUE_APP_I18N_LOCALE=en
VUE_APP_I18N_FALLBACK_LOCALE=en
# Empty = same origin as the page (the dev server proxies to the Monero backend)
VUE_APP_WS_SERVER=
VUE_APP_REST_API=
VUE_APP_STORAGE_URL=https://storage.txstreet.com/

#Use custom endpoints for any specific coin, e.g. VUE_APP_REST_API_XMR=http://host:8081
